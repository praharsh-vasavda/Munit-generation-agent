# GitHub
GITHUB_TOKEN=

# Confluence
CONFLUENCE_TOKEN=__REPLACE_ME__
CONFLUENCE_EMAIL=__REPLACE_ME__
CONFLUENCE_OrgId=__REPLACE_ME__

# LLM Settings
PRIMARY_LLM=anthropic/claude-sonnet-4-20250514
MAX_PROMPT_TOKENS=6000
LLM_TIMEOUT=60
PORT=5000
TEMPERATURE=0.7

# Output
OUTPUT_PATH=./output/

# LLM Configuration
GROQ_API_KEY=__REPLACE_ME__
GROQ_BASE_URL=https://api.groq.com
GROQ_MODEL=openai/gpt-oss-120b

# Cohere Configuration
COHERE_API_KEY=__REPLACE_ME__
COHERE_BASE_URL=https://api.cohere.ai/v1
COHERE_MODEL=command-r
#command-a-03-2025

# Anthropic Configuration
ANTHROPIC_API_KEY=__REPLACE_ME__
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
#claude-sonnet-3-5-20250929
ANTHROPIC_API_VERSION=2023-06-01

# OpenRouter Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=__REPLACE_ME__
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free

# Flask Configuration
SECRET_KEY=github-connector-secret-key-change-in-production

LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=__REPLACE_ME__
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct

# OpenAI Configuration
OPENAI_API_KEY=__REPLACE_ME__
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-3.5-turbo

# Gemini Configuration
GEMINI_API_KEY=__REPLACE_ME__
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.0-flash