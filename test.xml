<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
                          http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">

    <http:listener-config name="HTTP_Listener_config" doc:name="HTTP Listener config">
        <http:listener-connection host="0.0.0.0" port="8081" />
    </http:listener-config>
    
    <flow name="api-flow" doc:name="api-flow">
        <http:listener doc:name="Listener" config-ref="HTTP_Listener_config" path="/api/process"/>
        <set-payload doc:name="Set Payload" value='{"status": "processed", "message": "Success"}'/>
        <http:request doc:name="Call external API" config-ref="HTTP_Request_config" path="/external" method="POST"/>
    </flow>
    
    <http:request-config name="HTTP_Request_config" doc:name="HTTP Request config">
        <http:request-connection host="api.example.com" port="443"/>
    </http:request-config>

</mule>
